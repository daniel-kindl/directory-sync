<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    
    <!-- Tool Configuration -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dirsync</ToolCommandName>
    <PackageId>DirectorySync.Cli</PackageId>
    <Description>Production-ready directory synchronization CLI utility with one-way sync, change detection, and safety rails</Description>
    
    <!-- Package Information -->
    <Authors>Daniel Kindl</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/daniel-kindl/directory-sync</PackageProjectUrl>
    <RepositoryUrl>https://github.com/daniel-kindl/directory-sync</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>cli;sync;backup;directory;mirror;file-sync;replication;tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    
    <!-- Build Configuration -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Spectre.Console.Cli" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Engine\DirectorySync.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
